  "paths": {
    "/api/calc/{op}/{arg1}/{arg2}": {
      "get": {
        "tags": [
          "scs-rest"
        ],
        "summary": "calc",
        "operationId": "calcUsingGET",
        "produces": [
          "*/*"
        ],
        "parameters": [
          {
            "name": "arg1",
            "in": "path",
            "description": "arg1",
            "required": true,
            "type": "number",
            "format": "double",
            "x-example": 15.5
          },
          {
            "name": "arg2",
            "in": "path",
            "description": "arg2",
            "required": true,
            "type": "number",
            "format": "double",
            "x-example": 4.5
          },
          {
            "name": "op",
            "in": "path",
            "description": "op",
            "required": true,
            "type": "string",
            "x-example": "add"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "string"
            },
            "examples": {
              "application/json": "20.0"
            }
          },
          "400": {
            "description": "Client error — 400",
            "examples": {
              "application/json": {
                "timestamp": "2023-10-27T10:00:00.000Z",
                "status": 400,
                "error": "Bad Request",
                "message": "Invalid number format for input string: \"twenty\"",
                "path": "/api/calc/add/10/twenty"
              }
            }
          },
          "500": {
            "description": "Server error — 500",
            "examples": {
              "application/json": {
                "timestamp": "2023-10-27T10:01:00.000Z",
                "status": 500,
                "error": "Internal Server Error",
                "message": "An arithmetic error occurred: / by zero",
                "path": "/api/calc/divide/100/0"
              }
            }
          }
        },
        "deprecated": false,
        "x-parameter-examples": {
          "200": [
            {
              "_name": "typical_addition",
              "op": "add",
              "arg1": 15.5,
              "arg2": 4.5
            },
            {
              "_name": "edge_case_subtraction",
              "op": "subtract",
              "arg1": 0,
              "arg2": -50.25
            }
          ],
          "400": [
            {
              "_name": "invalid_type_for_argument",
              "op": "add",
              "arg1": 10,
              "arg2": "twenty"
            },
            {
              "_name": "unsupported_operation",
              "op": "power",
              "arg1": 2,
              "arg2": 8
            },
            {
              "_name": "missing_operation",
              "op": "",
              "arg1": 100,
              "arg2": 50
            }
          ],
          "500": [
            {
              "_name": "division_by_zero",
              "op": "divide",
              "arg1": 100,
              "arg2": 0
            },
            {
              "_name": "numeric_overflow",
              "op": "multiply",
              "arg1": 1.7976931348623157e+308,
              "arg2": 100
            },
            {
              "_name": "numeric_underflow",
              "op": "divide",
              "arg1": 5e-324,
              "arg2": 1e+300
            }
          ]
        }
      }
    },
